{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKER",
    "dockerfilePath": "docker-compose.yml",
    "compose": {
      "service": "openreplay",
      "env": {
        "DOMAIN_NAME": "${RAILWAY_PUBLIC_DOMAIN}",
        "POSTGRES_STRING": "${DATABASE_URL}",
        "REDIS_STRING": "${REDIS_STRING}",
        "JWT_SECRET": "${JWT_SECRET}"
      }
    }
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 40,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": null
  }
} 
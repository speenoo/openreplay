{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "./install.sh",
    "env": {
      "DOMAIN_NAME": "${RAILWAY_PUBLIC_DOMAIN}",
      "POSTGRES_STRING": "${DATABASE_URL}",
      "REDIS_STRING": "${REDIS_STRING}",
      "JWT_SECRET": "${JWT_SECRET}",
      "BEACON_SIZE_LIMIT": "7000000",
      "ASSETS_SIZE_LIMIT": "60291456",
      "DB_BATCH_SIZE_LIMIT": "10000000",
      "QUEUE_MESSAGE_SIZE_LIMIT": "1048576"
    }
  }
} 